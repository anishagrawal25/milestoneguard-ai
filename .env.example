# MilestoneGuard AI Environment Variables

# Payment mode: 'mock' (simulated PayPal checkout & payouts) or 'sandbox' (real PayPal sandbox API)
PAYMENT_MODE=mock

# PayPal REST API credentials (required if PAYMENT_MODE=sandbox)
# Get credentials at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CURRENCY=USD

# Google Gemini AI API credentials
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional GitHub Token for higher rate limits when analyzing repositories
GITHUB_TOKEN=

# Base URL for webhook registration and redirects
APP_BASE_URL=http://localhost:3000

# Sample repository for 1-click demo submission
DEMO_REPO_URL=https://github.com/anishagrawal25/dockerized-react-app

# SQLite database URL
DATABASE_URL="file:./dev.db"
